# ── Large binary dataset files ────────────────────────────────────
datasets/**/*.pbf
datasets/**/*.tif
datasets/**/*.tiff
datasets/**/*.hgt
datasets/**/*.osm
datasets/**/*.osm.pbf
datasets/osm_cache/

# ── Kaggle credentials (never commit these) ────────────────────────
.kaggle/kaggle.json
.kaggle/

# ── Environment variables ─────────────────────────────────────────
.env
.env.*

# ── Python virtual environments ───────────────────────────────────
myenv/
venv/
.venv/
env/

# ── Python cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
dist/
build/
.eggs/

# ── Generated output files (reproducible, no need to track) ───────
simulation_result.png
wildfire_prediction.png
wildfire_intelligence.html
kochi_simulation_intelligence.html
dashboard_template.html

# ── Trained model binaries (large) ────────────────────────────────
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
models/*.onnx

# ── Jupyter / IDE ─────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Pip cache ─────────────────────────────────────────────────────
pip_cache/
*.whl
